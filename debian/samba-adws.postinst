#!/bin/sh
# Leaves the unit installed and disabled, whatever the controller's state.
#
# Contract 4.2: a unit MUST NOT be enabled by default on install; enabling it
# is the administrator's explicit action, or the job of hardensamba-roles. An
# earlier version of this script enabled and started the service when a
# provisioned directory existed, and it never did so in practice: debhelper's
# own snippet above records the unit's state before this code runs,
# deb-systemd-helper enable defers to that record, and deb-systemd-invoke
# does not start a unit that is not enabled - so both calls were silent
# no-ops behind "|| true", and the unit was found disabled and inactive on a
# provisioned controller. The rule and the facts agree; the branch is gone.
#
# An upgrade restarts a running service onto the new code and leaves a
# stopped one stopped (try-restart); a fresh installation says on standard
# error what the administrator does next. Nothing here may fail the
# installation: a controller without a domain yet is a normal state.
#
# deb-systemd-invoke rather than systemctl: it honours policy-rc.d, which is
# what keeps this from restarting a service inside the chroot an image is
# built in.
#
# The SPN is deliberately not registered here. A maintainer script cannot
# assume the directory is up or that it may write to it; the step is
# documented in /usr/share/doc/samba-adws/documentation/02-installation.md.
set -e

#DEBHELPER#

case "$1" in
    configure)
        if [ -n "${2:-}" ]; then
            if [ -d /run/systemd/system ]; then
                deb-systemd-invoke try-restart samba-adws.service >/dev/null 2>&1 || true
            fi
        else
            echo "samba-adws: the service is installed and left disabled (contract 4.2)." >&2
            echo "samba-adws: once the directory is provisioned and host/<fqdn> is registered:" >&2
            echo "samba-adws:     systemctl enable --now samba-adws" >&2
        fi
        ;;
esac

exit 0
